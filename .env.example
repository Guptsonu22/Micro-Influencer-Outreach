# Environment Configuration for EDXSO AI Influencer Outreach System
# Copy this file to .env and fill in the values

# Application Settings
PROJECT_NAME="EDXSO AI Influencer Outreach System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="edxso_influencer_outreach"

# YouTube Data API v3
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=""

# AI / LLM Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Outreach Simulation & Sending Safeguards
# Live sending is disabled by default for safety. Set to true ONLY with approved SMTP credentials.
SIMULATION_MODE=true
ALLOW_LIVE_EMAIL_SENDING=false

# SMTP Configuration (Optional, active only when SIMULATION_MODE=false and ALLOW_LIVE_EMAIL_SENDING=true)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="EDXSO Partnerships"

# Frontend Origin for CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
